{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(python -m py_compile *)",
      "Bash(python -m unittest *)",
      "Bash(python tools/check_repo.py)",
      "Bash(python -I tools/verify_labels.py *)",
      "Bash(python -I tools/score.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git blame *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "PowerShell(python -m py_compile *)",
      "PowerShell(python -m unittest *)",
      "PowerShell(python tools/check_repo.py)",
      "PowerShell(python -I tools/verify_labels.py *)",
      "PowerShell(python -I tools/score.py *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git grep *)",
      "PowerShell(git blame *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch --list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh run list *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)"
    ],
    "deny": [
      "Bash(gh release *)",
      "Bash(gh pr merge *--auto*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh repo edit *)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push --tags *)",
      "Bash(git push *--tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "PowerShell(gh release *)",
      "PowerShell(gh pr merge *--auto*)",
      "PowerShell(gh pr merge *--admin*)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh api *-X*)",
      "PowerShell(gh api *--method*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * +*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * *:main)",
      "PowerShell(git push --tags *)",
      "PowerShell(git push *--tags*)",
      "PowerShell(git push *refs/tags/*)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push *--delete*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(~/.claude/.credentials.json)"
    ]
  }
}
